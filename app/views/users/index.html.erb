<h1>ユーザー一覧</h1>

<% if notice.present? %>
  <p><%= notice %></p>
<% end %>

<% if alert.present? %>
  <p><%= alert %></p>
<% end %>

<p><%= link_to "ユーザー登録", new_user_path %></p>
<p><%= link_to "ツイート一覧へ", root_path %></p>
<ul>
  <% @users.each do |user| %>
    <li>
      <%= user.uid %>

      <% if session[:login_uid] == user.uid %>
        <%= button_to "退会する", user_path(user),
              method: :delete,
              data: { turbo_confirm: "自分の投稿も削除されます。退会しますか？" } %>
      <% end %>
    </li>
  <% end %>
</ul>