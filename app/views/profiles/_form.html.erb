<% if @profile.errors.any? %>
  <div>
    <p>保存できませんでした。</p>
    <ul>
      <% @profile.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @profile, url: profile_path do |form| %>
  <p>
    <%= form.label :message, "自己紹介" %><br>
    <%= form.text_area :message, rows: 5, required: true %>
  </p>

  <%= form.submit "保存" %>
<% end %>

<p><%= link_to "ツイート一覧へ", root_path %></p>